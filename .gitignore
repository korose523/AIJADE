# ---- Third-party vendored model assets (14.2 GB; fetch via scripts, never commit) ----
# `third_party/see-s-through` ships ~13 GB of weights, `third_party/talking-head-anime-4-demo`
# ~1.2 GB of demo data. Both are downloadable artifacts, not source.
/third_party/see-s-through/weights/
/third_party/see-s-through/**/*.bin
/third_party/see-s-through/**/*.onnx
/third_party/see-s-through/**/*.pth
/third_party/see-s-through/**/*.safetensors
/third_party/see-s-through/**/*.ckpt
/third_party/talking-head-anime-4-demo/data/
# ...but keep the small hand-authored character reference images.
!/third_party/**/jade_maid_refs/
!/third_party/**/jade_maid_refs/**

# ---- Experiment / research artifacts (regenerable; may contain participant data) ----
# Telemetry JSONL + CSV exports from @proj-airi/research-telemetry. These can
# contain interaction logs, so they must never reach a public remote.
experiments/
**/experiments/**
*.jsonl
results/
analysis/output/
# Keep checked-in fixtures that tests depend on.
!**/__fixtures__/**/*.jsonl

# ---- EXCEPTION: preregistered study artifacts are primary evidence ----
# The rules above exist to keep telemetry (which can carry human interaction
# logs) off public remotes. The RQ-C skill-forge protocol has NO human
# participants: candidates are LLM-generated and graded by a deterministic
# sandbox oracle. So the privacy rationale does not apply, while the
# reproducibility obligation does — a results chapter whose raw trials are
# unpublished cannot be reviewed or recomputed by a referee.
# Scope is deliberately narrow: only the preregistered protocol directories.
!packages/research-harness/experiments/
!packages/research-harness/experiments/**
!packages/research-harness/experiments/rq-c/**
# The preserved degenerate run is kept ON PURPOSE: it is the evidence that the
# 2026-09-14 "null" was a null by construction, not an empirical finding.
!packages/research-harness/experiments/rq-c/**/*.jsonl
!packages/research-harness/experiments/rq-c/**/*.json

# ---- Local databases & runtime state ----
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.pgdata/
redis-data/
duckdb-data/

# ---- Local test residue & run backups ----
# Per-test registries written next to the real ones by the vitest suite.
**/eval/.*.registry.json
# Timestamped run backups (`trials.jsonl.bak-<epoch>`) are not products.
*.bak-*

# ---- Third-party research corpora (fetch, never commit) ----
# LoCoMo is Snap Research's dataset under its own terms; we redistribute the
# fetch script + pinned sha256, not the bytes. See eval/locomo-path.ts.
packages/memory-biomimetic/eval/data/

