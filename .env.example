# AIJADE 环境变量配置

# ========== 米家 Xiaomi Mi Home API ==========
XIAOMI_USERNAME=your_xiaomi_account_here
XIAOMI_PASSWORD=your_xiaomi_password_here
XIAOMI_REGION=cn

# ========== LLM 大模型 ==========
DASHSCOPE_API_KEY=your_dashscope_api_key

# ========== TTS 语音合成 ==========
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# ========== AIJADE Server ==========
AIJADE_SERVER_PORT=3000
AIJADE_SERVER_HOST=0.0.0.0

# ========== 琥珀 HE ==========
AMBER_HE_IP=192.168.1.100
HOLOGRAM_MODE=true

# ========== 数据库 ==========
DATABASE_URL=postgresql://aijade:aijade@localhost:5432/aijade
