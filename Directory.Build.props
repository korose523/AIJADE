<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API docs are welcome but not required on every member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>0.1.0</Version>
    <Authors>Zexiao Weng</Authors>
    <Copyright>Copyright (c) 2026 Zexiao Weng</Copyright>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Optional: put bin/obj outside the source tree (e.g. when the checkout lives on exFAT, which rejects
       the extended attributes MSBuild copies). Set AIJADE_ARTIFACTS to a directory on a native filesystem. -->
  <PropertyGroup Condition="'$(AIJADE_ARTIFACTS)' != ''">
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(AIJADE_ARTIFACTS)</ArtifactsPath>
  </PropertyGroup>
</Project>
