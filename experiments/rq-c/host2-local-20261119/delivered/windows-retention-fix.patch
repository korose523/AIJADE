+        with self.assertRaisesRegex(ValueError, "precede the current boot"):
+            windows.capture(json.dumps(packet).encode(), cfg, SINCE, END, CONFIG_SHA, COLLECTOR_SHA, [])
+        for pins in ({"Other": "a" * 64}, {"System": "bad"}, []):
+            with self.subTest(pins=pins), self.assertRaisesRegex(ValueError, "anchor pins"):
+                windows.config_from(json.dumps(dict(CFG, historicalAnchorSha256=pins)).encode())
