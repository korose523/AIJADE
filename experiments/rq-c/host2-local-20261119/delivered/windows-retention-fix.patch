 class WindowsCollectorTests(unittest.TestCase):
+    def test_historical_anchor_requires_exact_explicit_pin(self):
+        packet = native(END)
+        old = event("System", 1, -120, computer="OLD-NAME")
+        for side in ("before", "after"):
+            packet["channels"]["System"][side]["xml"] = old
+        with self.assertRaisesRegex(ValueError, "another computer"):
+            capture(packet)
+        cfg = dict(CFG, historicalAnchorSha256={"System": windows.sha(old.encode())})
+        def read(value, config=cfg):
+            return windows.capture(json.dumps(value).encode(), config, SINCE, END,
+                                   windows.sha(json.dumps(config).encode()), COLLECTOR_SHA, ["synthetic"])
+        result = read(packet)
+        self.assertEqual(cfg["historicalAnchorSha256"], result["sources"]["system"]["queryScope"]["historicalAnchorSha256"])
+        changed = copy.deepcopy(packet)
+        changed["channels"]["System"]["after"]["xml"] = old.replace("OLD-NAME", "OTHER-NAME")
+        with self.assertRaisesRegex(ValueError, "differs from its pin"):
+            read(changed)
+        bad = copy.deepcopy(packet)
+        bad["channels"]["System"]["events"] = [event("System", 99, 1, computer="OLD-NAME")]
+        with self.assertRaisesRegex(ValueError, "another computer"):
+            read(bad)
+        self.assertEqual(cfg, windows.config_from(json.dumps(cfg).encode()))
+
+    def test_historical_anchor_cannot_cover_current_boot_or_bad_channel(self):
+        packet = native(END)
