  "defaultScratch": [
    "<checkout>/.runtime/native-integration-controls",
    "<checkout>/.runtime/native-exec-controls"
  ],
  "macLocalOverride": "AIJADE_NATIVE_TEST_SCRATCH=/Volumes/Untitled/AIJADE/.runtime/posix/tmp/native-ready-portable-controls",
  "hardcodedResearchPathsInPortableEntrances": false,
  "sourceBinding": "exact frozen e918 full source bytes plus exact function bytes are required; no fallback or skip"
}
