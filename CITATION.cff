    given-names: Zexiao
    orcid: "https://orcid.org/0009-0009-8600-8954"
    affiliation: "Department of Computer and Information Engineering, Graduate School, Youngsan University, Busan 48015, Republic of Korea"
repository-code: "https://github.com/korose523/AIJADE"
license: MIT
keywords:
  - LLM agents
  - agent memory
  - self-verification
  - provenance
  - retrieval scoring
  - reproducibility
