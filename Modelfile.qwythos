# Qwythos-9B-Claude-Mythos-5-1M Modelfile for Ollama
# Model: empero-ai/Qwythos-9B-Claude-Mythos-5-1M-GGUF:Q4_K_M
# Base: Qwen3.5-9B | Context: up to 1M tokens | License: Apache-2.0
# 
# Usage: ollama create qwythos -f Modelfile.qwythos

FROM hf.co/empero-ai/Qwythos-9B-Claude-Mythos-5-1M-GGUF:Q4_K_M

# ========== Recommended Sampling Parameters ==========
# From Empero AI official recommendations (matching Qwen3.5 thinking-mode)
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER repeat_penalty 1.05

# ========== Context Window ==========
# Start with 32K (conservative). Can increase to 64K, 128K, 256K, up to 1M.
# RTX 5080 16GB: 32K-128K works well. For >256K consider tensor-parallel or KV offload.
PARAMETER num_ctx 32768

# ========== Response Length ==========
# Generous budget for <think> block + final answer
PARAMETER num_predict 16384

# ========== System Prompt ==========
# The v2 GGUF has the Qwythos/Empero identity embedded in the chat template.
# The following is a minimal prompt that won't conflict:
SYSTEM """You are Qwythos, an AI assistant created by Empero AI. You are a reasoning model — you think carefully before answering. You have access to tools when provided, and you support function calling. You are helpful, precise, and technically capable."""
