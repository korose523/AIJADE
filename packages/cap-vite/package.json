{
  "name": "@proj-aijade/cap-vite",
  "type": "module",
  "version": "0.10.2",
  "description": "CLI that starts a Vite dev server and runs Capacitor live reload",
  "author": {
    "name": "AIJADE Team"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/korose523/AIJADE.git",
    "directory": "packages/cap-vite"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "cap-vite": "./dist/bin/run.mjs"
  },
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@capacitor/cli": "catalog:capacitor-cli-8-0-0",
    "vite": "catalog:vite-7-0-0-or-8-0-0-beta-0"
  },
  "dependencies": {
    "cac": "catalog:",
    "tinyexec": "catalog:"
  }
}
