  {
   "id": "arr-sum",
   "instruction": "Write a function `sum(nums)` that returns the sum of an array of numbers (0 for an empty array).",
   "category": "array",
   "tier": "easy",
   "timeoutMs": null,
   "tests": [
    {
     "args": "[[1,2,3]]",
     "expected": "6"
    },
    {
     "args": "[[]]",
     "expected": "0"
    },
    {
     "args": "[[-1,-2,-3]]",
     "expected": "-6"
    },
    {
     "args": "[[5]]",
     "expected": "5"
    },
    {
     "args": "[[1,2,3,4,5]]",
     "expected": "15"
    }
   ]
  },
  {
   "id": "arr-max",
   "instruction": "Write a function `max(nums)` that returns the largest number in the array. For an empty array return -Infinity.",
   "category": "array",
   "tier": "easy",
   "timeoutMs": null,
   "tests": [
    {
     "args": "[[3,1,2]]",
     "expected": "3"
    },
    {
     "args": "[[-5,-1,-9]]",
     "expected": "-1"
