{
 "tasks": [
  {
   "id": "str-slugify",
   "instruction": "Write a function `slugify(s)` that converts a string to a URL slug: lowercase, trim, replace every run of non-alphanumeric characters with a single hyphen, and strip leading/trailing hyphens.",
   "category": "string",
   "tier": "medium",
   "timeoutMs": null,
   "tests": [
    {
     "args": "[\"Hello World\"]",
     "expected": "\"hello-world\""
    },
    {
     "args": "[\"  Foo   Bar!! \"]",
     "expected": "\"foo-bar\""
    },
    {
     "args": "[\"a---b\"]",
     "expected": "\"a-b\""
    },
    {
     "args": "[\"---\"]",
     "expected": "\"\""
    },
    {
     "args": "[\"Already-Slug\"]",
     "expected": "\"already-slug\""
    }
   ]
  },
  {
   "id": "str-reverse",
   "instruction": "Write a function `reverse(s)` that returns the reversed string.",
   "category": "string",
   "tier": "easy",
   "timeoutMs": null,
   "tests": [
    {
     "args": "[\"hello\"]",
     "expected": "\"olleh\""
    },
    {
     "args": "[\"\"]",
     "expected": "\"\""
    },
    {
     "args": "[\"a\"]",
     "expected": "\"a\""
    },
    {
     "args": "[\"racecar\"]",
     "expected": "\"racecar\""
    },
    {
     "args": "[\"ab c\"]",
     "expected": "\"c ba\""
    }
   ]
  },
  {
   "id": "str-is-palindrome",
   "instruction": "Write a function `isPalindrome(s)` that returns true iff the string is a palindrome, ignoring case and all non-alphanumeric characters.",
   "category": "string",
   "tier": "easy",
   "timeoutMs": null,
   "tests": [
    {
     "args": "[\"RaceCar\"]",
     "expected": "true"
    },
    {
     "args": "[\"A man, a plan, a canal: Panama\"]",
     "expected": "true"
    },
    {
     "args": "[\"hello\"]",
     "expected": "false"
    },
    {
     "args": "[\"  \"]",
     "expected": "true"
    },
    {
     "args": "[\"a\"]",
     "expected": "true"
    },
    {
     "args": "[\"\"]",
     "expected": "true"
    }
   ]
  },
  {
   "id": "str-capitalize-words",
