    {
     "args": "[\"a\"]",
     "expected": "\"A\""
    },
    {
     "args": "[\"  foo  bar \"]",
     "expected": "\"  Foo  Bar \""
    }
   ]
  },
  {
   "id": "str-count-vowels",
