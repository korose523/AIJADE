  {
   "id": "str-truncate",
   "instruction": "Write a function `truncate(s, maxLen)` that returns s unchanged if s.length <= maxLen, otherwise the first maxLen characters followed by the ellipsis character \"…\". If maxLen <= 0 return an empty string.",
   "category": "string",
   "tier": "medium",
   "timeoutMs": null,
   "tests": [
    {
     "args": "[\"hello world\",5]",
     "expected": "\"hello…\""
    },
    {
     "args": "[\"hello\",5]",
     "expected": "\"hello\""
    },
    {
     "args": "[\"\",5]",
     "expected": "\"\""
    },
    {
     "args": "[\"abc\",0]",
     "expected": "\"\""
    },
    {
     "args": "[\"abcdef\",3]",
     "expected": "\"abc…\""
    },
    {
     "args": "[\"hi\",10]",
     "expected": "\"hi\""
    }
   ]
