   "category": "string",
   "tier": "medium",
   "timeoutMs": null,
   "tests": [
    {
     "args": "[\"hello world\"]",
     "expected": "\"Hello World\""
    },
    {
     "args": "[\"HELLO WORLD\"]",
     "expected": "\"Hello World\""
    },
    {
     "args": "[\"\"]",
     "expected": "\"\""
