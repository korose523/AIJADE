<Project Sdk="Microsoft.NET.Sdk">
  <!-- Computer control for the companion as an MCP server over stdio (run by the server's tool hub as an mcp-stdio
       provider, or by any MCP client). Port of the author's agent-computer-use contract: one computer_use tool;
       read-only actions always allowed; desktop-changing actions refused unless explicitly allowed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
</Project>
