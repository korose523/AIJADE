<Project Sdk="Microsoft.NET.Sdk">
  <!-- The companion on chat platforms: one process, a connector per configured platform, all answering through the
       CompanionBridge with a bot account on the AIJADE server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Log volume is tiny (connects, failures); source-generated logging is not worth it here, as in the server. -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Discord.Net" />
    <PackageReference Include="Telegram.Bot" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Aijade.Integrations/Aijade.Integrations.csproj" />
  </ItemGroup>
</Project>
